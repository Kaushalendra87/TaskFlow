# Local development defaults. Keep real credentials in backend/.env (never commit it).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# A fresh checkout uses SQLite and the local Redis service.
DB_ENGINE=sqlite
REDIS_URL=redis://127.0.0.1:6379/0

# Optional: use PostgreSQL instead of SQLite. Fill in your own values and set DB_ENGINE=postgresql.
# DB_ENGINE=postgresql
# DB_NAME=taskflow
# DB_USER=taskflow_user
# DB_PASSWORD=replace-with-your-local-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=disable
# DB_CONN_MAX_AGE=60

# For a non-debug deployment, set a unique DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS,
# and (when needed) DJANGO_CSRF_TRUSTED_ORIGINS in private environment configuration.
